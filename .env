# Server
PORT=3000

# Site key gate — required header (X-Site-Key) for POST /create and /create/stream
SITE_API_KEY=5a83ddc6a233537f1aeb7b2b979e70c841e15bf10645b38f6f228c5963d71eab

# CORS — comma-separated list of allowed origins for /create and /create/stream
ALLOWED_ORIGINS=https://nexusbot.qzz.io,https://api.nexusbot.qzz.io,https://pair.nexusbot.qzz.io

# Mongo — used both by useKeyvAuthState (via @nexustechpro/baileys) and
# directly by mongoExport.js for the filtered redeem read
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/database
MONGO_DB_NAME=keyv